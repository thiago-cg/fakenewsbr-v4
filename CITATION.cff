    given-names: Thiago
    email: thiago.vs007@gmail.com
year: 2026
version: "4.0"
license: other
repository-code: "https://github.com/thiago-cg/fakenewsbr-v4"
keywords:
  - fake news
  - fact-checking
  - misinformation
  - portuguese
  - pt-BR
  - pt-PT
